rules_version = '2';
// Conectwork · regras de segurança · etapas 0 e 1 (base e acesso)
// Princípio: cada empresa só lê e grava o que é dela. Tudo o que não está liberado aqui é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function meuEmail() { return request.auth.token.email.lower(); }
    function caminho(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function master() { return logado() && exists(caminho('master', request.auth.uid)); }

    function acessoDoc(emp) { return caminho('acessos', emp + '_' + request.auth.uid); }
    function membro(emp) { return logado() && exists(acessoDoc(emp)) && get(acessoDoc(emp)).data.ativo == true; }
    function admin(emp) { return membro(emp) && get(acessoDoc(emp)).data.cargo == 'admin'; }
    function fundador(emp) { return logado() && exists(caminho('empresas', emp)) && get(caminho('empresas', emp)).data.criadoPor == request.auth.uid; }
    // na gravação: vale o estado DEPOIS da operação (o cadastro grava empresa, área privada, acesso e histórico juntos)
    // quem acabou de entrar na empresa (aceitando um convite) grava o histórico na mesma operação
    function membroApos(emp) { return logado() && existsAfter(acessoDoc(emp)) && getAfter(acessoDoc(emp)).data.ativo == true; }
    function fundadorApos(emp) { return logado() && existsAfter(caminho('empresas', emp)) && getAfter(caminho('empresas', emp)).data.criadoPor == request.auth.uid; }

    // ---------- Equipe Conectwork ----------
    // O primeiro é criado à mão no console. Depois, a equipe convida (convites/{token} com tipo 'master'):
    // quem recebeu o convite entra com o próprio e-mail. Outra pessoa da equipe tira alguém; ninguém tira a si mesmo.
    function masterApos() { return logado() && existsAfter(caminho('master', request.auth.uid)); }
    function conviteMaster(tk) {
      let c = get(caminho('convites', tk)).data;
      return c.get('tipo', '') == 'master' && c.usado == false && c.email == meuEmail();
    }
    match /master/{uid} {
      allow read: if logado() && (request.auth.uid == uid || master());
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','email','convite','criadoEm'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 120
        && request.resource.data.email == meuEmail()
        && request.resource.data.criadoEm == request.time
        && conviteMaster(request.resource.data.convite);
      allow update: if false;
      allow delete: if master() && request.auth.uid != uid;
    }

    // ---------- Perfil da pessoa ----------
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || master());
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','email','tel','zap','criadoEm','atualizadoEm'])
        && request.resource.data.email == meuEmail();
      allow delete: if false;
    }

    // ---------- Empresas ----------
    match /empresas/{emp} {
      allow read: if master() || membro(emp) || fundador(emp)
        || (logado() && resource.data.status == 'aprovado');
      // cadastro novo sempre entra em análise, sem módulos nem plano (o plano e os módulos quem define é a equipe master).
      // O CNPJ é reservado em cnpjs/{número} na mesma operação: CNPJ repetido não entra.
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['tipo','status','nome','razao','cnpj','cnpjNum','cidade','uf','protocolo','criadoPor','criadoEm','enviadoEm'])
        && request.resource.data.status == 'analise'
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.tipo in ['contratante','ambos','prestador']
        && request.resource.data.cnpjNum is string && request.resource.data.cnpjNum.matches('[0-9]{14}')
        && request.resource.data.protocolo is string && request.resource.data.protocolo.matches('CW-[0-9]{4}-[0-9]{4,}')
        && request.resource.data.criadoEm == request.time
        && existsAfter(caminho('cnpjs', request.resource.data.cnpjNum))
        && getAfter(caminho('cnpjs', request.resource.data.cnpjNum)).data.empresaId == emp;
      // equipe master decide; a empresa só reenvia o cadastro quando foi pedido ajuste
      allow update: if master()
        || ((admin(emp) || fundador(emp))
            && resource.data.status == 'pendencia'
            && request.resource.data.status == 'analise'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status','nome','razao','cidade','uf','tipo','enviadoEm']));   // o CNPJ não muda na correção
      allow delete: if false;

      match /privado/{doc} {
        allow read: if master() || membro(emp) || fundador(emp);
        allow create: if fundadorApos(emp) && !('taxa' in request.resource.data) && !('conferidos' in request.resource.data);
        allow update: if master()
          || ((admin(emp) || fundador(emp))
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['taxa','conferidos']));
        allow delete: if false;
      }
    }

    // ---------- Acessos (pessoa x empresa) · id = empresaId_uid ----------
    function cargos() { return ['admin','solicitante','aprovador','financeiro','tesouraria','rh','operacional','contador','consulta']; }
    function aceitaConvite(id) {
      let d = request.resource.data;
      let c = get(caminho('convites', d.convite)).data;
      return logado()
        && id == d.empresaId + '_' + request.auth.uid
        && d.uid == request.auth.uid
        && c.usado == false
        && c.get('tipo', '') != 'master'
        && c.email == meuEmail()
        && c.empresaId == d.empresaId
        && c.cargo == d.cargo
        && d.ativo == true
        // quem aceita não escolhe nada além do convite: sem telas a mais nem a menos, com o próprio e-mail
        && d.keys().hasOnly(['uid','empresaId','nome','email','cargo','extras','sem','ativo','convite','criadoEm'])
        && d.extras == [] && d.sem == []
        && d.email == meuEmail();
    }
    function fundadorVirandoAdmin(id) {
      let d = request.resource.data;
      return logado()
        && id == d.empresaId + '_' + request.auth.uid
        && d.uid == request.auth.uid
        && fundadorApos(d.empresaId)
        && d.cargo == 'admin'
        && d.ativo == true
        && d.extras == [] && d.sem == [];
    }
    match /acessos/{id} {
      allow read: if logado() && (resource.data.uid == request.auth.uid || admin(resource.data.empresaId) || master());
      allow create: if master()
        || ('convite' in request.resource.data && aceitaConvite(id))
        || fundadorVirandoAdmin(id);
      // admin muda cargo, ajuste (extras/sem) e bloqueio de OUTRA pessoa; nunca o próprio
      allow update: if master()
        || (admin(resource.data.empresaId)
            && resource.data.uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cargo','extras','sem','ativo','atualizadoEm'])
            && request.resource.data.cargo in cargos()
            && request.resource.data.extras is list && request.resource.data.sem is list
            && request.resource.data.ativo is bool);
      allow delete: if false;
    }

    // ---------- Convites ----------
    match /convites/{token} {
      allow get: if logado() && (resource.data.email == meuEmail() || admin(resource.data.empresaId) || master());
      allow list: if logado() && (admin(resource.data.empresaId) || master());
      allow create: if master()
        || (admin(request.resource.data.empresaId)
            && request.resource.data.keys().hasOnly(['email','nome','tel','empresaId','empresaNome','cargo','criadoPor','criadoPorNome','criadoEm','usado'])
            && request.resource.data.usado == false
            && request.resource.data.criadoPor == request.auth.uid
            && request.resource.data.cargo in cargos()
            && request.resource.data.email is string
            && request.resource.data.email == request.resource.data.email.lower());
      // admin só marca o reenvio (o link é o mesmo); quem foi convidado marca como usado ao aceitar
      allow update: if master()
        || (admin(resource.data.empresaId) && resource.data.usado == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reenviadoEm']))
        || (logado() && resource.data.email == meuEmail() && resource.data.usado == false
            && request.resource.data.usado == true
            && request.resource.data.usadoPor == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado','usadoEm','usadoPor']));
      allow delete: if master() || admin(resource.data.empresaId);
    }

    // ---------- Contratos (equipe contínua) · docs/PLANO-COBRANCA-NOTAS.md ----------
    // Lê quem é das duas empresas (e a equipe master). Muda só o administrador de cada lado, e só do jeito previsto:
    // corrigir/cancelar (tomador, antes de assinado), assinar (cada lado o seu), propor e responder mudança de vencimento
    // (nunca por um lado só) e encerrar o serviço. Nada se apaga.
    function camposContrato() { return ['modalidade','tomadorId','prestadorId','partes','tomadorNome','tomadorCnpj','prestadorNome','prestadorCnpj',
      'objeto','periodicidade','vencimentoDias','inicio','fim','status','assinaturas','interlocutor','proposta','criadoPor','criadoPorNome',
      'criadoEm','atualizadoEm','ativadoEm','encerramento','triagem']; }
    function meuLado(c) { return admin(c.tomadorId) ? 'tomador' : (admin(c.prestadorId) ? 'prestador' : ''); }
    function vencOk(n) { return n is int && n >= 0 && n <= 90; }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // equipe contínua mede por quinzena ou mês; serviço por entrega (OS) não tem medição do período
    function modalOk(d) { return (d.modalidade == 'continua' && d.periodicidade in ['quinzena','mes']) || (d.modalidade == 'os' && d.periodicidade == ''); }
    function contratoCorrigir(r, d) {
      return admin(r.tomadorId) && r.status == 'assinatura' && d.status == 'assinatura' && d.assinaturas == {}
        && mudou().hasOnly(['objeto','periodicidade','vencimentoDias','inicio','fim','assinaturas','atualizadoEm'])
        && modalOk(d) && vencOk(d.vencimentoDias);
    }
    // Triagem (Lei 6.019, arts. 5º-C e 5º-D): o resultado é recalculado aqui a partir das respostas; o tomador só assina com
    // "compatível" ou "requer análise jurídica" com parecer favorável registrado.
    function respOk(v) { return v in ['sim','nao']; }
    function triRisco(q) { return q.entrega == 'nao' || q.supervisor == 'nao' || q.ordens == 'sim' || q.jornada == 'sim' || q.exclusiv == 'sim'; }
    function triBloq(q) { return q.exempregado == 'sim' || q.socio == 'sim'; }
    function triResultadoOk(t) {
      let q = t.r;
      return q.keys().hasOnly(['entrega','supervisor','ordens','jornada','exclusiv','exempregado','socio'])
        && q.keys().hasAll(['entrega','supervisor','ordens','jornada','exclusiv','exempregado','socio'])
        && respOk(q.entrega) && respOk(q.supervisor) && respOk(q.ordens) && respOk(q.jornada) && respOk(q.exclusiv) && respOk(q.exempregado) && respOk(q.socio)
        && (t.resultado == 'nao_publicar') == triBloq(q)
        && (t.resultado == 'analise_juridica') == (!triBloq(q) && triRisco(q));
    }
    function triLibera(c) {
      return 'triagem' in c && c.triagem != null
        && (c.triagem.resultado == 'compativel' || (c.triagem.resultado == 'analise_juridica' && c.triagem.parecer != null && c.triagem.parecer.ok == true));
    }
    function contratoTriagem(r, d) {
      let t = d.triagem;
      return admin(r.tomadorId) && r.status in ['assinatura','ativo'] && r.status == d.status && mudou().hasOnly(['triagem','atualizadoEm'])
        && t.keys().hasOnly(['r','resultado','parecer','uid','nome','em']) && t.resultado in ['compativel','analise_juridica','nao_publicar'] && triResultadoOk(t)
        && ((t.uid == request.auth.uid && t.parecer == null)
            || ('triagem' in r && r.triagem != null && r.triagem.resultado == 'analise_juridica' && t.r == r.triagem.r && t.resultado == r.triagem.resultado
                && t.uid == r.triagem.uid && t.parecer.ok == true && t.parecer.uid == request.auth.uid && t.parecer.obs is string && t.parecer.obs.size() >= 10));
    }
    function contratoAssinar(r, d) {
      let lado = meuLado(r);
      let outro = lado == 'tomador' ? 'prestador' : 'tomador';
      return lado != '' && r.status == 'assinatura' && !(lado in r.assinaturas)
        && mudou().hasOnly(['assinaturas','status','ativadoEm','interlocutor','atualizadoEm'])
        && d.assinaturas.diff(r.assinaturas).affectedKeys().hasOnly([lado])
        && d.assinaturas[lado].uid == request.auth.uid
        && (lado == 'prestador' || (!mudou().hasAny(['interlocutor']) && triLibera(r)))
        && ((outro in r.assinaturas && d.status == 'ativo') || (!(outro in r.assinaturas) && d.status == 'assinatura'));
    }
    function contratoCancelar(r, d) { return admin(r.tomadorId) && r.status == 'assinatura' && d.status == 'cancelado' && mudou().hasOnly(['status','atualizadoEm']); }
    function contratoPropor(r, d) {
      return meuLado(r) != '' && r.status == 'ativo' && r.proposta == null && mudou().hasOnly(['proposta','atualizadoEm'])
        && d.proposta.lado == meuLado(r) && d.proposta.uid == request.auth.uid && vencOk(d.proposta.vencimentoDias);
    }
    function contratoResponder(r, d) {
      return meuLado(r) != '' && r.status == 'ativo' && r.proposta != null && r.proposta.lado != meuLado(r) && d.proposta == null
        && mudou().hasOnly(['proposta','vencimentoDias','atualizadoEm'])
        && (d.vencimentoDias == r.vencimentoDias || d.vencimentoDias == r.proposta.vencimentoDias);
    }
    function contratoEncerrar(r, d) {
      return meuLado(r) != '' && r.status == 'ativo' && d.status == 'encerrado' && mudou().hasOnly(['status','encerramento','proposta','atualizadoEm'])
        && d.encerramento.lado == meuLado(r) && d.encerramento.uid == request.auth.uid;
    }
    match /contratos/{id} {
      allow read: if master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId);
      allow create: if admin(request.resource.data.tomadorId)
        && (!('triagem' in request.resource.data) || request.resource.data.triagem == null)
        && request.resource.data.keys().hasOnly(camposContrato())
        && modalOk(request.resource.data)
        && request.resource.data.status == 'assinatura'
        && request.resource.data.assinaturas == {} && request.resource.data.proposta == null && request.resource.data.interlocutor == null
        && request.resource.data.tomadorId != request.resource.data.prestadorId
        && request.resource.data.partes == [request.resource.data.tomadorId, request.resource.data.prestadorId]
        && get(caminho('empresas', request.resource.data.prestadorId)).data.status == 'aprovado'
        && vencOk(request.resource.data.vencimentoDias)
        && request.resource.data.criadoPor == request.auth.uid && request.resource.data.criadoEm == request.time;
      allow update: if request.resource.data.keys().hasOnly(camposContrato())
        && !mudou().hasAny(['modalidade','tomadorId','prestadorId','partes','tomadorNome','tomadorCnpj','prestadorNome','prestadorCnpj','criadoPor','criadoEm'])
        && ((mudou().hasAny(['triagem']) && contratoTriagem(resource.data, request.resource.data))
            || (!mudou().hasAny(['triagem']) && (contratoCorrigir(resource.data, request.resource.data) || contratoAssinar(resource.data, request.resource.data)
            || contratoCancelar(resource.data, request.resource.data) || contratoPropor(resource.data, request.resource.data)
            || contratoResponder(resource.data, request.resource.data) || contratoEncerrar(resource.data, request.resource.data))));
      allow delete: if false;
    }

    // ---------- Medição do período (equipe contínua) · id = contratoId_período ----------
    // Lança: admin ou RH do tomador, com contrato ativo. Confere: admin ou financeiro da prestadora.
    // Aprova: admin ou aprovador técnico do tomador, e nunca quem lançou (funções separadas). Nada se apaga.
    function cargoEm(emp, lista) { return membro(emp) && get(acessoDoc(emp)).data.cargo in lista; }
    function camposMedicao() { return ['contratoId','tomadorId','prestadorId','partes','tomadorNome','prestadorNome','periodicidade','periodo',
      'valorCentavos','memoria','obs','origem','ref','status','divergencia','confirmacao','aprovacao','criadoPor','criadoPorNome','criadoEm','atualizadoEm']; }
    function periodoOk(p, per) { return per == 'quinzena' ? p.matches('[0-9]{4}-(0[1-9]|1[0-2])-[12]') : p.matches('[0-9]{4}-(0[1-9]|1[0-2])'); }
    function medicaoCriar(id, d) {
      let c = get(caminho('contratos', d.contratoId)).data;
      return cargoEm(d.tomadorId, ['admin','rh'])
        && d.keys().hasOnly(camposMedicao())
        && id == d.contratoId + '_' + d.periodo
        && c.status == 'ativo' && c.tomadorId == d.tomadorId && c.prestadorId == d.prestadorId
        && d.partes == [d.tomadorId, d.prestadorId] && d.periodicidade == c.periodicidade && periodoOk(d.periodo, c.periodicidade)
        && d.valorCentavos is int && d.valorCentavos > 0 && d.memoria is list && d.memoria.size() > 0 && d.memoria.size() <= 300
        && d.status == 'enviada' && d.divergencia == null && d.confirmacao == null && d.aprovacao == null
        && d.origem in ['manual','integracao'] && d.criadoPor == request.auth.uid && d.criadoEm == request.time;
    }
    function medicaoCorrigir(r, d) {
      return cargoEm(r.tomadorId, ['admin','rh']) && r.status in ['enviada','divergencia'] && d.status == 'enviada'
        && d.divergencia == null && d.confirmacao == null && d.valorCentavos is int && d.valorCentavos > 0 && d.memoria is list && d.memoria.size() > 0
        && mudou().hasOnly(['memoria','valorCentavos','obs','status','divergencia','confirmacao','atualizadoEm']);
    }
    function medicaoConfirmar(r, d) {
      return cargoEm(r.prestadorId, ['admin','financeiro']) && r.status == 'enviada' && d.status == 'confirmada_prestadora'
        && d.confirmacao.uid == request.auth.uid && mudou().hasOnly(['status','confirmacao','atualizadoEm']);
    }
    function medicaoDivergir(r, d) {
      return cargoEm(r.prestadorId, ['admin','financeiro']) && r.status == 'enviada' && d.status == 'divergencia'
        && d.divergencia.uid == request.auth.uid && d.divergencia.motivo is string && d.divergencia.motivo.size() >= 10
        && mudou().hasOnly(['status','divergencia','atualizadoEm']);
    }
    function medicaoAprovar(r, d) {
      return cargoEm(r.tomadorId, ['admin','aprovador']) && r.status == 'confirmada_prestadora' && d.status == 'aprovada'
        && d.aprovacao.uid == request.auth.uid && request.auth.uid != r.criadoPor && mudou().hasOnly(['status','aprovacao','atualizadoEm']);
    }
    function medicaoCancelar(r, d) {
      return cargoEm(r.tomadorId, ['admin','rh']) && r.status in ['enviada','divergencia','confirmada_prestadora'] && d.status == 'cancelada'
        && mudou().hasOnly(['status','atualizadoEm']);
    }
    match /medicoes/{id} {
      // quem lança confere antes se o período já tem medição (documento que não existe pode ser consultado)
      allow get: if logado() && (resource == null || master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId));
      allow list: if master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId);
      allow create: if medicaoCriar(id, request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(camposMedicao())
        // cada situação nova vai direto à sua verificação (menos avaliação = longe do limite do Firestore)
        && ((request.resource.data.status == 'enviada' && medicaoCorrigir(resource.data, request.resource.data))
            || (request.resource.data.status == 'confirmada_prestadora' && medicaoConfirmar(resource.data, request.resource.data))
            || (request.resource.data.status == 'divergencia' && medicaoDivergir(resource.data, request.resource.data))
            || (request.resource.data.status == 'aprovada' && medicaoAprovar(resource.data, request.resource.data))
            || (request.resource.data.status == 'cancelada' && medicaoCancelar(resource.data, request.resource.data)));
      allow delete: if false;
    }

    // ---------- Espelho da nota · id = id da medição (uma medição, um espelho) ----------
    // Prepara e corrige: admin ou financeiro do tomador, só com a medição aprovada e enquanto a nota não chegou.
    // Valor = o da medição; vencimento = o do contrato (não muda no espelho); líquido = valor − retenções. A prestadora lê. Nada se apaga.
    function camposEspelho() { return ['medicaoId','contratoId','tomadorId','prestadorId','partes','tomadorNome','prestadorNome','prestadorCnpj','tomador',
      'periodo','competencia','descricao','valorCentavos','retencoes','liquidoCentavos','vencimentoDias','obs','status','versao',
      'criadoPor','criadoPorNome','criadoEm','atualizadoPor','atualizadoPorNome','atualizadoEm','emissao','nota','recusadas','conferenciaNota','origem','osNumero']; }
    function centavos(v) { return v is int && v >= 0; }
    function espelhoValores(d) {
      let r = d.retencoes;
      return r.keys().hasOnly(['iss','inss','ir','pcc']) && r.keys().hasAll(['iss','inss','ir','pcc'])
        && centavos(r.iss) && centavos(r.inss) && centavos(r.ir) && centavos(r.pcc)
        && d.liquidoCentavos is int && d.liquidoCentavos > 0 && d.liquidoCentavos == d.valorCentavos - r.iss - r.inss - r.ir - r.pcc
        && d.descricao is string && d.descricao.size() >= 10 && d.descricao.size() <= 1000
        && d.obs is string && d.obs.size() <= 300;
    }
    function espelhoCriar(id, d) {
      return (('origem' in d && d.origem == 'os') && espelhoCriarOs(id, d)) || (!('origem' in d && d.origem == 'os') && espelhoCriarMed(id, d));
    }
    // ordem de serviço aceita: valor = valor aceito; competência = mês do aceite (período AAAA-MM)
    function espelhoCriarOs(id, d) {
      let o = get(caminho('ordens', id)).data;
      let c = get(caminho('contratos', o.contratoId)).data;
      return cargoEm(o.tomadorId, ['admin','financeiro'])
        && d.keys().hasOnly(camposEspelho())
        && d.medicaoId == id && o.status in ['aceita_total','aceita_parcial']
        && d.tomadorId == o.tomadorId && d.prestadorId == o.prestadorId && d.contratoId == o.contratoId && d.partes == [o.tomadorId, o.prestadorId]
        && d.periodo is string && d.periodo.matches('[0-9]{4}-(0[1-9]|1[0-2])') && d.competencia == d.periodo
        && d.valorCentavos == o.aceite.valorAceito && d.vencimentoDias == c.vencimentoDias && espelhoValores(d)
        && d.tomador.cnpj is string && d.tomador.razao is string
        && d.status == 'aguardando_nota' && d.versao == 1
        && d.criadoPor == request.auth.uid && d.criadoEm == request.time && d.atualizadoPor == request.auth.uid;
    }
    function espelhoCriarMed(id, d) {
      let m = get(caminho('medicoes', id)).data;
      let c = get(caminho('contratos', m.contratoId)).data;
      return cargoEm(m.tomadorId, ['admin','financeiro'])
        && d.keys().hasOnly(camposEspelho())
        && d.medicaoId == id && m.status == 'aprovada'
        && d.tomadorId == m.tomadorId && d.prestadorId == m.prestadorId && d.contratoId == m.contratoId && d.partes == [m.tomadorId, m.prestadorId]
        && d.periodo == m.periodo && d.competencia == m.periodo[0:7] && d.valorCentavos == m.valorCentavos
        && d.vencimentoDias == c.vencimentoDias && espelhoValores(d)
        && d.tomador.cnpj is string && d.tomador.razao is string
        && d.status == 'aguardando_nota' && d.versao == 1
        && d.criadoPor == request.auth.uid && d.criadoEm == request.time && d.atualizadoPor == request.auth.uid;
    }
    function espelhoCorrigir(r, d) {
      return cargoEm(r.tomadorId, ['admin','financeiro']) && r.status == 'aguardando_nota' && d.status == 'aguardando_nota'
        && mudou().hasOnly(['descricao','retencoes','liquidoCentavos','obs','versao','atualizadoPor','atualizadoPorNome','atualizadoEm'])
        && d.versao == r.versao + 1 && d.atualizadoPor == request.auth.uid && espelhoValores(d);
    }
    // A prestadora (admin, financeiro ou operacional) registra que abriu o emissor e envia a nota.
    // A nota precisa reservar a chave (notaschave) e ter o arquivo guardado na mesma operação; XML só entra se bater com o espelho.
    function espelhoEmissao(r, d) {
      return cargoEm(r.prestadorId, ['admin','financeiro','operacional']) && r.status == 'aguardando_nota' && d.status == 'aguardando_nota'
        && mudou().hasOnly(['emissao','atualizadoEm']) && d.emissao.uid == request.auth.uid;
    }
    function espelhoNota(id, r, d) {
      let n = d.nota;
      return cargoEm(r.prestadorId, ['admin','financeiro','operacional']) && r.status == 'aguardando_nota' && d.status == 'nota_enviada'
        && mudou().hasOnly(['status','nota','atualizadoEm'])
        && n.enviadoPor == request.auth.uid && n.chaveUnica is string && n.chaveUnica.size() >= 10 && n.chaveUnica.size() <= 80
        && n.tipo in ['pdf','xml'] && n.partes is int && n.partes >= 1 && n.partes <= 6 && n.conferencia.ok is bool
        && (n.tipo == 'pdf' || (n.conferencia.ok == true && n.valorCentavos == r.valorCentavos))
        && existsAfter(/databases/$(database)/documents/espelhos/$(id)/arquivos/$(n.envio + '-' + string(n.partes - 1)))
        && existsAfter(caminho('notaschave', n.chaveUnica)) && getAfter(caminho('notaschave', n.chaveUnica)).data.espelhoId == id;
    }
    // Quem contrata (admin ou financeiro) confere a nota ou recusa com motivo; a recusa fica na lista "recusadas" (nada se apaga).
    function espelhoConferirNota(id, r, d) {
      return cargoEm(r.tomadorId, ['admin','financeiro']) && r.status == 'nota_enviada' && d.status == 'nota_ok'
        && mudou().hasOnly(['status','conferenciaNota','atualizadoEm']) && d.conferenciaNota.uid == request.auth.uid
        && existsAfter(caminho('titulos', id));
    }
    function espelhoRecusarNota(r, d) {
      let antes = 'recusadas' in r ? r.recusadas.size() : 0;
      return cargoEm(r.tomadorId, ['admin','financeiro']) && r.status == 'nota_enviada' && d.status == 'aguardando_nota' && d.nota == null
        && mudou().hasOnly(['status','nota','emissao','recusadas','atualizadoEm'])
        && d.recusadas.size() == antes + 1 && (antes == 0 || d.recusadas[0:antes] == r.recusadas)
        && d.recusadas[antes].uid == request.auth.uid && d.recusadas[antes].motivo is string && d.recusadas[antes].motivo.size() >= 10
        && d.recusadas[antes].chaveUnica == r.nota.chaveUnica;
    }
    match /espelhos/{id} {
      allow get: if logado() && (resource == null || master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId));
      allow list: if master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId);
      allow create: if espelhoCriar(id, request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(camposEspelho())
        && ((resource.data.status == 'aguardando_nota' && request.resource.data.status == 'aguardando_nota'
              && (espelhoCorrigir(resource.data, request.resource.data) || espelhoEmissao(resource.data, request.resource.data)))
            || (request.resource.data.status == 'nota_enviada' && espelhoNota(id, resource.data, request.resource.data))
            || (request.resource.data.status == 'nota_ok' && espelhoConferirNota(id, resource.data, request.resource.data))
            || (resource.data.status == 'nota_enviada' && request.resource.data.status == 'aguardando_nota' && espelhoRecusarNota(resource.data, request.resource.data)));
      allow delete: if false;

      // arquivo da nota (PDF ou XML) em pedaços: só a prestadora grava, enquanto espera a nota; nunca muda nem some
      match /arquivos/{arq} {
        allow get: if master() || membro(get(caminho('espelhos', id)).data.tomadorId) || membro(get(caminho('espelhos', id)).data.prestadorId);
        allow list: if false;
        allow create: if cargoEm(get(caminho('espelhos', id)).data.prestadorId, ['admin','financeiro','operacional'])
          && get(caminho('espelhos', id)).data.status == 'aguardando_nota'
          && request.resource.data.keys().hasOnly(['d','k','envio','em'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 750000
          && request.resource.data.k is int && request.resource.data.k >= 0 && request.resource.data.k < 6
          && arq == request.resource.data.envio + '-' + string(request.resource.data.k);
        allow update, delete: if false;
      }
    }

    // ---------- Nota já usada · id = chave de acesso (ou CNPJ do emitente_número): uma nota não serve para dois espelhos ----------
    match /notaschave/{chave} {
      allow get: if logado() && (resource == null || membro(resource.data.prestadorId) || membro(resource.data.tomadorId));
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['espelhoId','prestadorId','tomadorId','em'])
        && cargoEm(request.resource.data.prestadorId, ['admin','financeiro','operacional'])
        && getAfter(caminho('espelhos', request.resource.data.espelhoId)).data.prestadorId == request.resource.data.prestadorId
        && getAfter(caminho('espelhos', request.resource.data.espelhoId)).data.nota.chaveUnica == chave;
      allow update, delete: if false;
    }

    // ---------- Títulos (contas a pagar e a receber) · id = id do espelho ----------
    // Nasce com a nota conferida, na mesma gravação. Funções separadas: quem conferiu a nota não libera; o financeiro libera;
    // a tesouraria agenda e confirma o pagamento com comprovante; quem liberou não confirma o pagamento. A prestadora informa a
    // conta (área privada do título); trocar a conta exige revisão do financeiro do tomador antes de agendar. Nada se apaga.
    function camposTitulo() { return ['espelhoId','medicaoId','contratoId','tomadorId','prestadorId','partes','tomadorNome','prestadorNome','periodo','notaNumero','chaveUnica',
      'valorCentavos','liquidoCentavos','retencoes','vencimentoDias','base','status','aprovacao','liberacao','agendamento','liquidacao','baixa','conta','criadoEm','atualizadoEm']; }
    function tituloCriar(id, d) {
      let e = getAfter(caminho('espelhos', id)).data;
      return cargoEm(e.tomadorId, ['admin','financeiro']) && d.keys().hasOnly(camposTitulo())
        && e.status == 'nota_ok' && e.conferenciaNota.uid == request.auth.uid
        && d.espelhoId == id && d.tomadorId == e.tomadorId && d.prestadorId == e.prestadorId && d.partes == [e.tomadorId, e.prestadorId]
        && d.valorCentavos == e.valorCentavos && d.liquidoCentavos == e.liquidoCentavos && d.vencimentoDias == e.vencimentoDias && d.chaveUnica == e.nota.chaveUnica
        && d.base == request.time && d.status == 'aprovado' && d.aprovacao.uid == request.auth.uid
        && d.liberacao == null && d.agendamento == null && d.liquidacao == null && d.baixa == null
        && d.conta == {'ok': false, 'revisao': false, 'versao': 0};
    }
    function tituloLiberar(r, d) {
      return cargoEm(r.tomadorId, ['admin','financeiro']) && r.status == 'aprovado' && d.status == 'liberado'
        && request.auth.uid != r.aprovacao.uid && d.liberacao.uid == request.auth.uid && mudou().hasOnly(['status','liberacao','atualizadoEm']);
    }
    function tituloAgendar(r, d) {
      return cargoEm(r.tomadorId, ['admin','tesouraria']) && r.status == 'liberado' && d.status == 'agendado'
        && r.conta.ok == true && r.conta.revisao == false
        && d.agendamento.uid == request.auth.uid && d.agendamento.data is string && d.agendamento.data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && mudou().hasOnly(['status','agendamento','atualizadoEm']);
    }
    function tituloLiquidar(id, r, d) {
      let cp = d.liquidacao.comprovante;
      return cargoEm(r.tomadorId, ['admin','tesouraria']) && r.status == 'agendado' && d.status == 'liquidado'
        && request.auth.uid != r.liberacao.uid && d.liquidacao.uid == request.auth.uid && d.liquidacao.data is string
        && cp.partes is int && cp.partes >= 1 && cp.partes <= 6
        && existsAfter(/databases/$(database)/documents/titulos/$(id)/arquivos/$(cp.envio + '-' + string(cp.partes - 1)))
        && mudou().hasOnly(['status','liquidacao','atualizadoEm']);
    }
    function tituloBaixar(r, d) {
      return cargoEm(r.prestadorId, ['admin','financeiro']) && r.status == 'liquidado' && d.status == 'baixado'
        && d.baixa.uid == request.auth.uid && mudou().hasOnly(['status','baixa','atualizadoEm']);
    }
    function tituloConta(id, r, d) {
      return cargoEm(r.prestadorId, ['admin','financeiro']) && r.status in ['aprovado','liberado'] && r.status == d.status
        && mudou().hasOnly(['conta','atualizadoEm']) && d.conta.ok == true && d.conta.revisao == r.conta.ok
        && d.conta.versao == r.conta.versao + 1
        && existsAfter(/databases/$(database)/documents/titulos/$(id)/privado/conta)
        && getAfter(/databases/$(database)/documents/titulos/$(id)/privado/conta).data.versao == d.conta.versao;
    }
    function tituloRevisarConta(r, d) {
      return cargoEm(r.tomadorId, ['admin','financeiro']) && r.status in ['aprovado','liberado'] && r.status == d.status
        && r.conta.revisao == true && d.conta.revisao == false && d.conta.ok == true && d.conta.versao == r.conta.versao
        && d.conta.revisadoPor == request.auth.uid && mudou().hasOnly(['conta','atualizadoEm']);
    }
    match /titulos/{id} {
      allow read: if master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId);
      allow create: if tituloCriar(id, request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(camposTitulo())
        && ((request.resource.data.status == resource.data.status
              && (tituloConta(id, resource.data, request.resource.data) || tituloRevisarConta(resource.data, request.resource.data)))
            || (request.resource.data.status == 'liberado' && resource.data.status == 'aprovado' && tituloLiberar(resource.data, request.resource.data))
            || (request.resource.data.status == 'agendado' && tituloAgendar(resource.data, request.resource.data))
            || (request.resource.data.status == 'liquidado' && tituloLiquidar(id, resource.data, request.resource.data))
            || (request.resource.data.status == 'baixado' && tituloBaixar(resource.data, request.resource.data)));
      allow delete: if false;

      // conta para receber: só quem cuida de dinheiro nas duas empresas lê (LGPD); só a prestadora escreve, junto com o título
      match /privado/conta {
        allow get: if master() || cargoEm(get(caminho('titulos', id)).data.tomadorId, ['admin','financeiro','tesouraria'])
          || cargoEm(get(caminho('titulos', id)).data.prestadorId, ['admin','financeiro']);
        allow create, update: if cargoEm(get(caminho('titulos', id)).data.prestadorId, ['admin','financeiro'])
          && request.resource.data.keys().hasOnly(['banco','agencia','conta','tipo','pix','titular','doc','versao','em','por','porNome'])
          && request.resource.data.por == request.auth.uid
          && getAfter(caminho('titulos', id)).data.conta.versao == request.resource.data.versao;
        allow delete: if false;
      }
      // comprovante do pagamento em pedaços: só a tesouraria (ou admin) do tomador, quando está agendado; nunca muda
      match /arquivos/{arq} {
        allow get: if master() || membro(get(caminho('titulos', id)).data.tomadorId) || membro(get(caminho('titulos', id)).data.prestadorId);
        allow create: if cargoEm(get(caminho('titulos', id)).data.tomadorId, ['admin','tesouraria'])
          && get(caminho('titulos', id)).data.status == 'agendado'
          && request.resource.data.keys().hasOnly(['d','k','envio','em'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 750000
          && request.resource.data.k is int && request.resource.data.k >= 0 && request.resource.data.k < 6
          && arq == request.resource.data.envio + '-' + string(request.resource.data.k);
        allow update, delete: if false;
      }
    }

    // ---------- Avaliação do serviço da prestadora · id = id do título (uma por período) ----------
    // Avalia: admin ou aprovador técnico do tomador, depois do pagamento. A prestadora (admin ou financeiro) responde uma vez. Nada se apaga.
    function notaOk(v) { return v is int && v >= 1 && v <= 5; }
    match /avaliacoes/{id} {
      allow read: if master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId);
      allow create: if cargoEm(request.resource.data.tomadorId, ['admin','aprovador'])
        && request.resource.data.keys().hasOnly(['tipo','tituloId','contratoId','tomadorId','prestadorId','partes','periodo','notas','comentario','por','porNome','em','resposta'])
        && request.resource.data.tipo == 'servico_prestadora' && request.resource.data.tituloId == id
        && get(caminho('titulos', id)).data.status in ['liquidado','baixado']
        && get(caminho('titulos', id)).data.tomadorId == request.resource.data.tomadorId
        && get(caminho('titulos', id)).data.prestadorId == request.resource.data.prestadorId
        && get(caminho('titulos', id)).data.contratoId == request.resource.data.contratoId
        && request.resource.data.partes == [request.resource.data.tomadorId, request.resource.data.prestadorId]
        && request.resource.data.notas.keys().hasOnly(['qualidade','prazo','comunicacao','escopo']) && request.resource.data.notas.keys().hasAll(['qualidade','prazo','comunicacao','escopo'])
        && notaOk(request.resource.data.notas.qualidade) && notaOk(request.resource.data.notas.prazo) && notaOk(request.resource.data.notas.comunicacao) && notaOk(request.resource.data.notas.escopo)
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 1000
        && request.resource.data.por == request.auth.uid && request.resource.data.em == request.time && request.resource.data.resposta == null;
      allow update: if cargoEm(resource.data.prestadorId, ['admin','financeiro']) && resource.data.resposta == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta'])
        && request.resource.data.resposta.uid == request.auth.uid && request.resource.data.resposta.texto is string
        && request.resource.data.resposta.texto.size() >= 5 && request.resource.data.resposta.texto.size() <= 1000;
      allow delete: if false;
    }

    // ---------- Documentos e certidões da empresa (arquivo em pedaços em documentos/{id}/arquivos) ----------
    // Quem envia: admin, financeiro, RH ou operacional da própria empresa. Certidões e segurança do trabalho podem ser
    // compartilhadas (são vistas por quem contrata; certidão é documento público). Documentos do cadastro nunca são
    // compartilhados. Enviar de novo marca o anterior como substituído. Nada se apaga.
    function camposDoc() { return ['empresaId','tipo','grupo','nome','validade','compartilhar','status','arquivo','enviadoPor','enviadoPorNome','criadoEm','substituidoEm','substituidoPor']; }
    function podeDoc(emp) { return cargoEm(emp, ['admin','financeiro','rh','operacional']); }
    function lerDoc(d) { return master() || membro(d.empresaId) || (logado() && d.compartilhar == true); }
    match /documentos/{id} {
      allow read: if lerDoc(resource.data);
      allow create: if podeDoc(request.resource.data.empresaId)
        && request.resource.data.keys().hasOnly(camposDoc())
        && request.resource.data.tipo is string && request.resource.data.tipo.matches('[a-z_]{2,20}')
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 120
        && request.resource.data.validade is string && (request.resource.data.validade == '' || request.resource.data.validade.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.compartilhar is bool
        && (!(request.resource.data.tipo in ['contrato','cartao','endereco','identidade','outro']) || request.resource.data.compartilhar == false)
        && request.resource.data.status == 'vigente' && request.resource.data.enviadoPor == request.auth.uid && request.resource.data.criadoEm == request.time
        && request.resource.data.arquivo.partes is int && request.resource.data.arquivo.partes >= 1 && request.resource.data.arquivo.partes <= 10
        && existsAfter(/databases/$(database)/documents/documentos/$(id)/arquivos/$(request.resource.data.arquivo.envio + '-' + string(request.resource.data.arquivo.partes - 1)));
      allow update: if podeDoc(resource.data.empresaId) && resource.data.status == 'vigente' && request.resource.data.status == 'substituido'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','substituidoEm','substituidoPor']);
      allow delete: if false;
      match /arquivos/{arq} {
        allow get: if lerDoc(get(caminho('documentos', id)).data);
        allow list: if false;
        allow create: if podeDoc(getAfter(caminho('documentos', id)).data.empresaId)
          && !exists(caminho('documentos', id))
          && request.resource.data.keys().hasOnly(['d','k','envio','em'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 750000
          && request.resource.data.k is int && request.resource.data.k >= 0 && request.resource.data.k < 10
          && request.resource.data.envio == getAfter(caminho('documentos', id)).data.arquivo.envio
          && arq == request.resource.data.envio + '-' + string(request.resource.data.k);
        allow update, delete: if false;
      }
    }

    // ---------- Meu negócio (profissional/prestadora) ----------
    // faturamento/{emp}: faturamento fora do Conectwork e outros clientes; privado (admin e financeiro da empresa).
    // independencia/{emp}: só o número de clientes, que a empresa escolhe mostrar a quem contrata (sem nomes nem valores).
    match /faturamento/{emp} {
      allow read: if master() || cargoEm(emp, ['admin','financeiro']);
      allow create, update: if cargoEm(emp, ['admin','financeiro'])
        && request.resource.data.keys().hasOnly(['anos','clientes','em','por'])
        && request.resource.data.anos is map && request.resource.data.clientes is list && request.resource.data.clientes.size() <= 200
        && request.resource.data.por == request.auth.uid;
      allow delete: if false;
    }
    // fiscal/{emp}: DAS pagos e DASN-SIMEI entregue (marcados pela própria empresa)
    match /fiscal/{emp} {
      allow read: if master() || cargoEm(emp, ['admin','financeiro']);
      allow create, update: if cargoEm(emp, ['admin','financeiro'])
        && request.resource.data.keys().hasOnly(['das','dasn','em','por'])
        && request.resource.data.das is map && request.resource.data.dasn is map && request.resource.data.por == request.auth.uid;
      allow delete: if false;
    }
    match /independencia/{emp} {
      allow read: if logado();
      allow create, update: if cargoEm(emp, ['admin','financeiro'])
        && request.resource.data.keys().hasOnly(['nClientes','compartilhar','em','por'])
        && request.resource.data.nClientes is int && request.resource.data.nClientes >= 0 && request.resource.data.nClientes <= 999
        && request.resource.data.compartilhar is bool && request.resource.data.por == request.auth.uid;
      allow delete: if false;
    }

    // ---------- Modelo de nota (assistente de emissão): código de tributação, município, complemento ----------
    match /notamodelo/{emp} {
      allow read: if master() || cargoEm(emp, ['admin','financeiro','operacional']);
      allow create, update: if cargoEm(emp, ['admin','financeiro','operacional'])
        && request.resource.data.keys().hasOnly(['codigo','codigoDesc','municipio','complemento','em','por'])
        && request.resource.data.codigo is string && request.resource.data.codigo.matches('[0-9]{2}[.][0-9]{2}[.][0-9]{2}')
        && request.resource.data.por == request.auth.uid;
      allow delete: if false;
    }

    // ---------- Logo da empresa · id = empresaId: todos os logados veem; só o admin da empresa troca ou tira ----------
    match /logos/{emp} {
      allow read: if logado();
      allow create, update: if admin(emp)
        && request.resource.data.keys().hasOnly(['d','nome','em','por'])
        && request.resource.data.d is string && request.resource.data.d.size() <= 200000
        && request.resource.data.d.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+')
        && request.resource.data.por == request.auth.uid;
      allow delete: if admin(emp);
    }

    // ---------- Sites para emitir a nota por cidade (o espelho escolhe sozinho): todos leem, só a equipe Conectwork muda ----------
    match /config/emissores {
      allow read: if logado();
      allow write: if master() && request.resource.data.keys().hasOnly(['cidades','em','por']) && request.resource.data.cidades is map;
    }

    // ---------- Ordens de serviço (contrato de serviço por entrega) ----------
    // Quem contrata (admin ou solicitante) propõe a OS com escopo, prazo e valor da entrega (nunca por hora). O profissional
    // ou a prestadora (admin, financeiro ou operacional) aceita ou recusa: recusar não tem punição. Entrega com descrição
    // (e arquivo, se quiser). Quem contrata (admin ou aprovador, nunca quem pediu a OS) aceita total, parcial (com motivo) ou
    // aponta divergência. Nada se apaga.
    function camposOs() { return ['contratoId','tomadorId','prestadorId','partes','tomadorNome','prestadorNome','numero','titulo','escopo','prazo','valorCentavos',
      'status','aceiteProf','recusa','entrega','entregas','divergencia','aceite','cancelamento','criadoPor','criadoPorNome','criadoEm','atualizadoEm']; }
    function osCriar(d) {
      let c = get(caminho('contratos', d.contratoId)).data;
      return cargoEm(d.tomadorId, ['admin','solicitante']) && d.keys().hasOnly(camposOs())
        && c.modalidade == 'os' && c.status == 'ativo' && c.tomadorId == d.tomadorId && c.prestadorId == d.prestadorId && d.partes == [d.tomadorId, d.prestadorId]
        && d.numero is int && d.titulo is string && d.titulo.size() >= 5 && d.titulo.size() <= 120 && d.escopo is string && d.escopo.size() >= 10 && d.escopo.size() <= 2000
        && d.prazo is string && d.prazo.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.valorCentavos is int && d.valorCentavos > 0
        && d.status == 'proposta' && d.aceiteProf == null && d.recusa == null && d.entrega == null && d.aceite == null && d.entregas == [] && d.divergencia == null && d.cancelamento == null
        && d.criadoPor == request.auth.uid && d.criadoEm == request.time;
    }
    function osResponder(r, d) {
      return cargoEm(r.prestadorId, ['admin','financeiro','operacional']) && r.status == 'proposta'
        && ((d.status == 'aceita' && d.aceiteProf.uid == request.auth.uid && mudou().hasOnly(['status','aceiteProf','atualizadoEm']))
            || (d.status == 'recusada' && d.recusa.uid == request.auth.uid && d.recusa.motivo is string && d.recusa.motivo.size() <= 300 && mudou().hasOnly(['status','recusa','atualizadoEm'])));
    }
    function osEntregar(id, r, d) {
      return cargoEm(r.prestadorId, ['admin','financeiro','operacional']) && r.status in ['aceita','divergencia'] && d.status == 'entregue'
        && d.entrega.uid == request.auth.uid && d.entrega.descricao is string && d.entrega.descricao.size() >= 10 && d.entrega.descricao.size() <= 2000
        && d.entregas.size() == r.entregas.size() + 1 && mudou().hasOnly(['status','entrega','entregas','atualizadoEm'])
        && (d.entrega.arquivo == null || existsAfter(/databases/$(database)/documents/ordens/$(id)/arquivos/$(d.entrega.arquivo.envio + '-' + string(d.entrega.arquivo.partes - 1))));
    }
    function osAceitar(r, d) {
      return cargoEm(r.tomadorId, ['admin','aprovador']) && request.auth.uid != r.criadoPor && r.status == 'entregue'
        && mudou().hasOnly(['status','aceite','atualizadoEm']) && d.aceite.uid == request.auth.uid
        && ((d.status == 'aceita_total' && d.aceite.valorAceito == r.valorCentavos)
            || (d.status == 'aceita_parcial' && d.aceite.valorAceito is int && d.aceite.valorAceito > 0 && d.aceite.valorAceito < r.valorCentavos && d.aceite.motivo is string && d.aceite.motivo.size() >= 10));
    }
    function osDivergir(r, d) {
      return cargoEm(r.tomadorId, ['admin','aprovador']) && r.status == 'entregue' && d.status == 'divergencia'
        && d.divergencia.uid == request.auth.uid && d.divergencia.motivo is string && d.divergencia.motivo.size() >= 10 && mudou().hasOnly(['status','divergencia','atualizadoEm']);
    }
    function osCancelar(r, d) {
      return cargoEm(r.tomadorId, ['admin','solicitante']) && r.status in ['proposta','aceita'] && d.status == 'cancelada'
        && d.cancelamento.uid == request.auth.uid && d.cancelamento.motivo is string && d.cancelamento.motivo.size() >= 5 && mudou().hasOnly(['status','cancelamento','atualizadoEm']);
    }
    match /ordens/{id} {
      allow read: if master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId);
      allow create: if osCriar(request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(camposOs())
        && ((request.resource.data.status in ['aceita','recusada'] && osResponder(resource.data, request.resource.data))
            || (request.resource.data.status == 'entregue' && osEntregar(id, resource.data, request.resource.data))
            || (request.resource.data.status in ['aceita_total','aceita_parcial'] && osAceitar(resource.data, request.resource.data))
            || (request.resource.data.status == 'divergencia' && osDivergir(resource.data, request.resource.data))
            || (request.resource.data.status == 'cancelada' && osCancelar(resource.data, request.resource.data)));
      allow delete: if false;
      match /arquivos/{arq} {
        allow get: if master() || membro(get(caminho('ordens', id)).data.tomadorId) || membro(get(caminho('ordens', id)).data.prestadorId);
        allow create: if cargoEm(get(caminho('ordens', id)).data.prestadorId, ['admin','financeiro','operacional'])
          && get(caminho('ordens', id)).data.status in ['aceita','divergencia']
          && request.resource.data.keys().hasOnly(['d','k','envio','em'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 750000
          && request.resource.data.k is int && request.resource.data.k >= 0 && request.resource.data.k < 10
          && arq == request.resource.data.envio + '-' + string(request.resource.data.k);
        allow update, delete: if false;
      }
    }

    // ---------- CNPJ reservado (impede cadastro repetido) · id = só os 14 números ----------
    // Qualquer pessoa logada consulta se o CNPJ já tem cadastro (o CNPJ é dado público).
    // Só nasce junto com a empresa, por quem a está cadastrando; nunca muda nem some pelo app.
    match /cnpjs/{num} {
      allow get: if logado();
      allow list: if false;
      allow create: if logado()
        && num.matches('[0-9]{14}')
        && request.resource.data.keys().hasOnly(['empresaId','criadoEm'])
        && request.resource.data.criadoEm == request.time
        && existsAfter(caminho('empresas', request.resource.data.empresaId))
        && getAfter(caminho('empresas', request.resource.data.empresaId)).data.criadoPor == request.auth.uid
        && getAfter(caminho('empresas', request.resource.data.empresaId)).data.cnpjNum == num;
      allow update, delete: if false;
    }

    // ---------- Contador do protocolo (CW-AAAA-0000): só anda de 1 em 1 e recomeça no ano novo ----------
    match /contadores/protocolo {
      allow get: if logado();
      allow create: if logado() && request.resource.data.keys().hasOnly(['ano','n'])
        && request.resource.data.n == 1 && request.resource.data.ano is int;
      allow update: if logado() && request.resource.data.keys().hasOnly(['ano','n'])
        && ((request.resource.data.ano == resource.data.ano && request.resource.data.n == resource.data.n + 1)
            || (request.resource.data.ano > resource.data.ano && request.resource.data.n == 1));
      allow delete: if false;
    }

    // ---------- Autorizações (consentimentos) · id = uid_finalidade; histórico em consentimentos_log ----------
    function consentOk(d) {
      return d.keys().hasOnly(['uid','finalidade','aceite','texto','textoVersao','canal','em','revogadoEm'])
        && d.uid == request.auth.uid
        && d.finalidade in ['operacional','contrato','cobranca','cursos','ofertas','whatsapp','email','push']
        && d.aceite is bool && d.texto is string && d.textoVersao is string && d.canal is string
        && d.em == request.time;
    }
    match /consentimentos/{id} {
      allow read: if logado() && (resource.data.uid == request.auth.uid || master());
      allow create, update: if logado() && id == request.auth.uid + '_' + request.resource.data.finalidade && consentOk(request.resource.data);
      allow delete: if false;
    }
    match /consentimentos_log/{id} {
      allow read: if logado() && (resource.data.uid == request.auth.uid || master());
      allow create: if logado() && consentOk(request.resource.data);
      allow update, delete: if false;
    }

    // ---------- Histórico de alterações ----------
    match /log/{id} {
      allow create: if logado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time      // hora do servidor (serverTimestamp), ninguém escolhe a data
        && (master() || masterApos() || membroApos(request.resource.data.empresaId) || fundadorApos(request.resource.data.empresaId));
      allow read: if master() || (logado() && admin(resource.data.empresaId));
      allow update, delete: if false;
    }

    // ---------- Planos: valor da mensalidade de cada plano (centavos) e dia do vencimento. Todos leem; só a equipe muda ----------
    match /config/planos {
      allow read: if logado();
      allow write: if master() && request.resource.data.keys().hasOnly(['valores','diaVenc','em','por'])
        && request.resource.data.valores is map
        && request.resource.data.diaVenc is int && request.resource.data.diaVenc >= 1 && request.resource.data.diaVenc <= 28;
    }

    // ---------- Mensalidades do Conectwork (a receita: sem comissão sobre os serviços) · id = empresaId_AAAA-MM ----------
    // A equipe gera e dá baixa (só com a data em que o dinheiro entrou: aberta não é paga). A empresa (admin e financeiro) só lê.
    function camposMens() { return ['empresaId','empresaNome','comp','plano','valorCentavos','venc','status','pagoNoDia','pagoPor','pagoEm','obs','criadoEm','criadoPor','atualizadoEm']; }
    function dataOk(v) { return v is string && v.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'); }
    match /mensalidades/{id} {
      allow read: if master() || cargoEm(resource.data.empresaId, ['admin','financeiro']);
      allow create: if master() && request.resource.data.keys().hasOnly(camposMens())
        && id == request.resource.data.empresaId + '_' + request.resource.data.comp
        && request.resource.data.comp is string && request.resource.data.comp.matches('[0-9]{4}-(0[1-9]|1[0-2])')
        && request.resource.data.valorCentavos is int && request.resource.data.valorCentavos >= 0
        && dataOk(request.resource.data.venc)
        && request.resource.data.status in ['aberta','isenta']
        && request.resource.data.criadoEm == request.time;
      allow update: if master() && request.resource.data.keys().hasOnly(camposMens())
        && mudou().hasOnly(['status','pagoNoDia','pagoPor','pagoEm','obs','valorCentavos','venc','atualizadoEm'])
        && request.resource.data.status in ['aberta','paga','isenta']
        && request.resource.data.valorCentavos is int && request.resource.data.valorCentavos >= 0 && dataOk(request.resource.data.venc)
        && (request.resource.data.status != 'paga' || (dataOk(request.resource.data.pagoNoDia) && request.resource.data.pagoPor is string))
        // valor e vencimento só mudam enquanto a mensalidade está aberta
        && (resource.data.status == 'aberta' || (request.resource.data.valorCentavos == resource.data.valorCentavos && request.resource.data.venc == resource.data.venc));
      allow delete: if false;
    }

    // ---------- Avisos da equipe Conectwork para a rede: todos leem; só a equipe publica e tira do ar (nada se apaga) ----------
    match /avisos/{id} {
      allow read: if logado();
      allow create: if master() && request.resource.data.keys().hasOnly(['titulo','texto','tipo','para','ate','ativo','criadoEm','criadoPor','criadoPorNome'])
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 3 && request.resource.data.titulo.size() <= 120
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000
        && request.resource.data.tipo in ['info','atencao']
        && request.resource.data.para in ['todos','tomadores','prestadores']
        && (request.resource.data.ate == '' || dataOk(request.resource.data.ate))
        && request.resource.data.ativo == true
        && request.resource.data.criadoPor == request.auth.uid && request.resource.data.criadoEm == request.time;
      allow update: if master() && mudou().hasOnly(['ativo','titulo','texto','tipo','para','ate','atualizadoEm'])
        && request.resource.data.ativo is bool
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 3 && request.resource.data.titulo.size() <= 120
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000
        && request.resource.data.tipo in ['info','atencao'] && request.resource.data.para in ['todos','tomadores','prestadores']
        && (request.resource.data.ate == '' || dataOk(request.resource.data.ate));
      allow delete: if false;
    }

    // ---------- Todo o resto: negado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
