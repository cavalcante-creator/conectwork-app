rules_version = '2';
// Conectwork · regras de segurança · etapas 0 e 1 (base e acesso)
// Princípio: cada empresa só lê e grava o que é dela. Tudo o que não está liberado aqui é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function meuEmail() { return request.auth.token.email.lower(); }
    function caminho(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function master() { return logado() && exists(caminho('master', request.auth.uid)); }

    function acessoDoc(emp) { return caminho('acessos', emp + '_' + request.auth.uid); }
    function membro(emp) { return logado() && exists(acessoDoc(emp)) && get(acessoDoc(emp)).data.ativo == true; }
    function admin(emp) { return membro(emp) && get(acessoDoc(emp)).data.cargo == 'admin'; }
    function fundador(emp) { return logado() && exists(caminho('empresas', emp)) && get(caminho('empresas', emp)).data.criadoPor == request.auth.uid; }
    // na gravação: vale o estado DEPOIS da operação (o cadastro grava empresa, área privada, acesso e histórico juntos)
    // quem acabou de entrar na empresa (aceitando um convite) grava o histórico na mesma operação
    function membroApos(emp) { return logado() && existsAfter(acessoDoc(emp)) && getAfter(acessoDoc(emp)).data.ativo == true; }
    function fundadorApos(emp) { return logado() && existsAfter(caminho('empresas', emp)) && getAfter(caminho('empresas', emp)).data.criadoPor == request.auth.uid; }

    // ---------- Equipe Conectwork ----------
    match /master/{uid} {
      allow read: if logado() && (request.auth.uid == uid || master());
      allow write: if false;                       // criado à mão no console
    }

    // ---------- Perfil da pessoa ----------
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || master());
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','email','tel','zap','criadoEm','atualizadoEm'])
        && request.resource.data.email == meuEmail();
      allow delete: if false;
    }

    // ---------- Empresas ----------
    match /empresas/{emp} {
      allow read: if master() || membro(emp) || fundador(emp)
        || (logado() && resource.data.status == 'aprovado');
      // cadastro novo sempre entra em análise, sem módulos nem plano (o plano e os módulos quem define é a equipe master).
      // O CNPJ é reservado em cnpjs/{número} na mesma operação: CNPJ repetido não entra.
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['tipo','status','nome','razao','cnpj','cnpjNum','cidade','uf','protocolo','criadoPor','criadoEm','enviadoEm'])
        && request.resource.data.status == 'analise'
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.tipo in ['contratante','ambos','prestador']
        && request.resource.data.cnpjNum is string && request.resource.data.cnpjNum.matches('[0-9]{14}')
        && request.resource.data.protocolo is string && request.resource.data.protocolo.matches('CW-[0-9]{4}-[0-9]{4,}')
        && request.resource.data.criadoEm == request.time
        && existsAfter(caminho('cnpjs', request.resource.data.cnpjNum))
        && getAfter(caminho('cnpjs', request.resource.data.cnpjNum)).data.empresaId == emp;
      // equipe master decide; a empresa só reenvia o cadastro quando foi pedido ajuste
      allow update: if master()
        || ((admin(emp) || fundador(emp))
            && resource.data.status == 'pendencia'
            && request.resource.data.status == 'analise'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status','nome','razao','cidade','uf','tipo','enviadoEm']));   // o CNPJ não muda na correção
      allow delete: if false;

      match /privado/{doc} {
        allow read: if master() || membro(emp) || fundador(emp);
        allow create: if fundadorApos(emp) && !('taxa' in request.resource.data) && !('conferidos' in request.resource.data);
        allow update: if master()
          || ((admin(emp) || fundador(emp))
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['taxa','conferidos']));
        allow delete: if false;
      }
    }

    // ---------- Acessos (pessoa x empresa) · id = empresaId_uid ----------
    function cargos() { return ['admin','solicitante','aprovador','financeiro','tesouraria','rh','operacional','contador','consulta']; }
    function aceitaConvite(id) {
      let d = request.resource.data;
      let c = get(caminho('convites', d.convite)).data;
      return logado()
        && id == d.empresaId + '_' + request.auth.uid
        && d.uid == request.auth.uid
        && c.usado == false
        && c.email == meuEmail()
        && c.empresaId == d.empresaId
        && c.cargo == d.cargo
        && d.ativo == true
        // quem aceita não escolhe nada além do convite: sem telas a mais nem a menos, com o próprio e-mail
        && d.keys().hasOnly(['uid','empresaId','nome','email','cargo','extras','sem','ativo','convite','criadoEm'])
        && d.extras == [] && d.sem == []
        && d.email == meuEmail();
    }
    function fundadorVirandoAdmin(id) {
      let d = request.resource.data;
      return logado()
        && id == d.empresaId + '_' + request.auth.uid
        && d.uid == request.auth.uid
        && fundadorApos(d.empresaId)
        && d.cargo == 'admin'
        && d.ativo == true
        && d.extras == [] && d.sem == [];
    }
    match /acessos/{id} {
      allow read: if logado() && (resource.data.uid == request.auth.uid || admin(resource.data.empresaId) || master());
      allow create: if master()
        || ('convite' in request.resource.data && aceitaConvite(id))
        || fundadorVirandoAdmin(id);
      // admin muda cargo, ajuste (extras/sem) e bloqueio de OUTRA pessoa; nunca o próprio
      allow update: if master()
        || (admin(resource.data.empresaId)
            && resource.data.uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cargo','extras','sem','ativo','atualizadoEm'])
            && request.resource.data.cargo in cargos()
            && request.resource.data.extras is list && request.resource.data.sem is list
            && request.resource.data.ativo is bool);
      allow delete: if false;
    }

    // ---------- Convites ----------
    match /convites/{token} {
      allow get: if logado() && (resource.data.email == meuEmail() || admin(resource.data.empresaId) || master());
      allow list: if logado() && (admin(resource.data.empresaId) || master());
      allow create: if master()
        || (admin(request.resource.data.empresaId)
            && request.resource.data.keys().hasOnly(['email','nome','tel','empresaId','empresaNome','cargo','criadoPor','criadoPorNome','criadoEm','usado'])
            && request.resource.data.usado == false
            && request.resource.data.criadoPor == request.auth.uid
            && request.resource.data.cargo in cargos()
            && request.resource.data.email is string
            && request.resource.data.email == request.resource.data.email.lower());
      // admin só marca o reenvio (o link é o mesmo); quem foi convidado marca como usado ao aceitar
      allow update: if master()
        || (admin(resource.data.empresaId) && resource.data.usado == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reenviadoEm']))
        || (logado() && resource.data.email == meuEmail() && resource.data.usado == false
            && request.resource.data.usado == true
            && request.resource.data.usadoPor == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado','usadoEm','usadoPor']));
      allow delete: if master() || admin(resource.data.empresaId);
    }

    // ---------- Contratos (equipe contínua) · docs/PLANO-COBRANCA-NOTAS.md ----------
    // Lê quem é das duas empresas (e a equipe master). Muda só o administrador de cada lado, e só do jeito previsto:
    // corrigir/cancelar (tomador, antes de assinado), assinar (cada lado o seu), propor e responder mudança de vencimento
    // (nunca por um lado só) e encerrar o serviço. Nada se apaga.
    function camposContrato() { return ['modalidade','tomadorId','prestadorId','partes','tomadorNome','tomadorCnpj','prestadorNome','prestadorCnpj',
      'objeto','periodicidade','vencimentoDias','inicio','fim','status','assinaturas','interlocutor','proposta','criadoPor','criadoPorNome',
      'criadoEm','atualizadoEm','ativadoEm','encerramento']; }
    function meuLado(c) { return admin(c.tomadorId) ? 'tomador' : (admin(c.prestadorId) ? 'prestador' : ''); }
    function vencOk(n) { return n is int && n >= 0 && n <= 90; }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function contratoCorrigir(r, d) {
      return admin(r.tomadorId) && r.status == 'assinatura' && d.status == 'assinatura' && d.assinaturas == {}
        && mudou().hasOnly(['objeto','periodicidade','vencimentoDias','inicio','fim','assinaturas','atualizadoEm'])
        && d.periodicidade in ['quinzena','mes'] && vencOk(d.vencimentoDias);
    }
    function contratoAssinar(r, d) {
      let lado = meuLado(r);
      let outro = lado == 'tomador' ? 'prestador' : 'tomador';
      return lado != '' && r.status == 'assinatura' && !(lado in r.assinaturas)
        && mudou().hasOnly(['assinaturas','status','ativadoEm','interlocutor','atualizadoEm'])
        && d.assinaturas.diff(r.assinaturas).affectedKeys().hasOnly([lado])
        && d.assinaturas[lado].uid == request.auth.uid
        && (lado == 'prestador' || !mudou().hasAny(['interlocutor']))
        && ((outro in r.assinaturas && d.status == 'ativo') || (!(outro in r.assinaturas) && d.status == 'assinatura'));
    }
    function contratoCancelar(r, d) { return admin(r.tomadorId) && r.status == 'assinatura' && d.status == 'cancelado' && mudou().hasOnly(['status','atualizadoEm']); }
    function contratoPropor(r, d) {
      return meuLado(r) != '' && r.status == 'ativo' && r.proposta == null && mudou().hasOnly(['proposta','atualizadoEm'])
        && d.proposta.lado == meuLado(r) && d.proposta.uid == request.auth.uid && vencOk(d.proposta.vencimentoDias);
    }
    function contratoResponder(r, d) {
      return meuLado(r) != '' && r.status == 'ativo' && r.proposta != null && r.proposta.lado != meuLado(r) && d.proposta == null
        && mudou().hasOnly(['proposta','vencimentoDias','atualizadoEm'])
        && (d.vencimentoDias == r.vencimentoDias || d.vencimentoDias == r.proposta.vencimentoDias);
    }
    function contratoEncerrar(r, d) {
      return meuLado(r) != '' && r.status == 'ativo' && d.status == 'encerrado' && mudou().hasOnly(['status','encerramento','proposta','atualizadoEm'])
        && d.encerramento.lado == meuLado(r) && d.encerramento.uid == request.auth.uid;
    }
    match /contratos/{id} {
      allow read: if master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId);
      allow create: if admin(request.resource.data.tomadorId)
        && request.resource.data.keys().hasOnly(camposContrato())
        && request.resource.data.modalidade == 'continua'
        && request.resource.data.status == 'assinatura'
        && request.resource.data.assinaturas == {} && request.resource.data.proposta == null && request.resource.data.interlocutor == null
        && request.resource.data.tomadorId != request.resource.data.prestadorId
        && request.resource.data.partes == [request.resource.data.tomadorId, request.resource.data.prestadorId]
        && get(caminho('empresas', request.resource.data.prestadorId)).data.status == 'aprovado'
        && request.resource.data.periodicidade in ['quinzena','mes'] && vencOk(request.resource.data.vencimentoDias)
        && request.resource.data.criadoPor == request.auth.uid && request.resource.data.criadoEm == request.time;
      allow update: if request.resource.data.keys().hasOnly(camposContrato())
        && !mudou().hasAny(['modalidade','tomadorId','prestadorId','partes','tomadorNome','tomadorCnpj','prestadorNome','prestadorCnpj','criadoPor','criadoEm'])
        && (contratoCorrigir(resource.data, request.resource.data) || contratoAssinar(resource.data, request.resource.data)
            || contratoCancelar(resource.data, request.resource.data) || contratoPropor(resource.data, request.resource.data)
            || contratoResponder(resource.data, request.resource.data) || contratoEncerrar(resource.data, request.resource.data));
      allow delete: if false;
    }

    // ---------- Medição do período (equipe contínua) · id = contratoId_período ----------
    // Lança: admin ou RH do tomador, com contrato ativo. Confere: admin ou financeiro da prestadora.
    // Aprova: admin ou aprovador técnico do tomador, e nunca quem lançou (funções separadas). Nada se apaga.
    function cargoEm(emp, lista) { return membro(emp) && get(acessoDoc(emp)).data.cargo in lista; }
    function camposMedicao() { return ['contratoId','tomadorId','prestadorId','partes','tomadorNome','prestadorNome','periodicidade','periodo',
      'valorCentavos','memoria','obs','origem','ref','status','divergencia','confirmacao','aprovacao','criadoPor','criadoPorNome','criadoEm','atualizadoEm']; }
    function periodoOk(p, per) { return per == 'quinzena' ? p.matches('[0-9]{4}-(0[1-9]|1[0-2])-[12]') : p.matches('[0-9]{4}-(0[1-9]|1[0-2])'); }
    function medicaoCriar(id, d) {
      let c = get(caminho('contratos', d.contratoId)).data;
      return cargoEm(d.tomadorId, ['admin','rh'])
        && d.keys().hasOnly(camposMedicao())
        && id == d.contratoId + '_' + d.periodo
        && c.status == 'ativo' && c.tomadorId == d.tomadorId && c.prestadorId == d.prestadorId
        && d.partes == [d.tomadorId, d.prestadorId] && d.periodicidade == c.periodicidade && periodoOk(d.periodo, c.periodicidade)
        && d.valorCentavos is int && d.valorCentavos > 0 && d.memoria is list && d.memoria.size() > 0 && d.memoria.size() <= 300
        && d.status == 'enviada' && d.divergencia == null && d.confirmacao == null && d.aprovacao == null
        && d.origem in ['manual','integracao'] && d.criadoPor == request.auth.uid && d.criadoEm == request.time;
    }
    function medicaoCorrigir(r, d) {
      return cargoEm(r.tomadorId, ['admin','rh']) && r.status in ['enviada','divergencia'] && d.status == 'enviada'
        && d.divergencia == null && d.confirmacao == null && d.valorCentavos is int && d.valorCentavos > 0 && d.memoria is list && d.memoria.size() > 0
        && mudou().hasOnly(['memoria','valorCentavos','obs','status','divergencia','confirmacao','atualizadoEm']);
    }
    function medicaoConfirmar(r, d) {
      return cargoEm(r.prestadorId, ['admin','financeiro']) && r.status == 'enviada' && d.status == 'confirmada_prestadora'
        && d.confirmacao.uid == request.auth.uid && mudou().hasOnly(['status','confirmacao','atualizadoEm']);
    }
    function medicaoDivergir(r, d) {
      return cargoEm(r.prestadorId, ['admin','financeiro']) && r.status == 'enviada' && d.status == 'divergencia'
        && d.divergencia.uid == request.auth.uid && d.divergencia.motivo is string && d.divergencia.motivo.size() >= 10
        && mudou().hasOnly(['status','divergencia','atualizadoEm']);
    }
    function medicaoAprovar(r, d) {
      return cargoEm(r.tomadorId, ['admin','aprovador']) && r.status == 'confirmada_prestadora' && d.status == 'aprovada'
        && d.aprovacao.uid == request.auth.uid && request.auth.uid != r.criadoPor && mudou().hasOnly(['status','aprovacao','atualizadoEm']);
    }
    function medicaoCancelar(r, d) {
      return cargoEm(r.tomadorId, ['admin','rh']) && r.status in ['enviada','divergencia','confirmada_prestadora'] && d.status == 'cancelada'
        && mudou().hasOnly(['status','atualizadoEm']);
    }
    match /medicoes/{id} {
      // quem lança confere antes se o período já tem medição (documento que não existe pode ser consultado)
      allow get: if logado() && (resource == null || master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId));
      allow list: if master() || membro(resource.data.tomadorId) || membro(resource.data.prestadorId);
      allow create: if medicaoCriar(id, request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(camposMedicao())
        && (medicaoCorrigir(resource.data, request.resource.data) || medicaoConfirmar(resource.data, request.resource.data)
            || medicaoDivergir(resource.data, request.resource.data) || medicaoAprovar(resource.data, request.resource.data)
            || medicaoCancelar(resource.data, request.resource.data));
      allow delete: if false;
    }

    // ---------- CNPJ reservado (impede cadastro repetido) · id = só os 14 números ----------
    // Qualquer pessoa logada consulta se o CNPJ já tem cadastro (o CNPJ é dado público).
    // Só nasce junto com a empresa, por quem a está cadastrando; nunca muda nem some pelo app.
    match /cnpjs/{num} {
      allow get: if logado();
      allow list: if false;
      allow create: if logado()
        && num.matches('[0-9]{14}')
        && request.resource.data.keys().hasOnly(['empresaId','criadoEm'])
        && request.resource.data.criadoEm == request.time
        && existsAfter(caminho('empresas', request.resource.data.empresaId))
        && getAfter(caminho('empresas', request.resource.data.empresaId)).data.criadoPor == request.auth.uid
        && getAfter(caminho('empresas', request.resource.data.empresaId)).data.cnpjNum == num;
      allow update, delete: if false;
    }

    // ---------- Contador do protocolo (CW-AAAA-0000): só anda de 1 em 1 e recomeça no ano novo ----------
    match /contadores/protocolo {
      allow get: if logado();
      allow create: if logado() && request.resource.data.keys().hasOnly(['ano','n'])
        && request.resource.data.n == 1 && request.resource.data.ano is int;
      allow update: if logado() && request.resource.data.keys().hasOnly(['ano','n'])
        && ((request.resource.data.ano == resource.data.ano && request.resource.data.n == resource.data.n + 1)
            || (request.resource.data.ano > resource.data.ano && request.resource.data.n == 1));
      allow delete: if false;
    }

    // ---------- Autorizações (consentimentos) · id = uid_finalidade; histórico em consentimentos_log ----------
    function consentOk(d) {
      return d.keys().hasOnly(['uid','finalidade','aceite','texto','textoVersao','canal','em','revogadoEm'])
        && d.uid == request.auth.uid
        && d.finalidade in ['operacional','contrato','cobranca','cursos','ofertas','whatsapp','email','push']
        && d.aceite is bool && d.texto is string && d.textoVersao is string && d.canal is string
        && d.em == request.time;
    }
    match /consentimentos/{id} {
      allow read: if logado() && (resource.data.uid == request.auth.uid || master());
      allow create, update: if logado() && id == request.auth.uid + '_' + request.resource.data.finalidade && consentOk(request.resource.data);
      allow delete: if false;
    }
    match /consentimentos_log/{id} {
      allow read: if logado() && (resource.data.uid == request.auth.uid || master());
      allow create: if logado() && consentOk(request.resource.data);
      allow update, delete: if false;
    }

    // ---------- Histórico de alterações ----------
    match /log/{id} {
      allow create: if logado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time      // hora do servidor (serverTimestamp), ninguém escolhe a data
        && (master() || membroApos(request.resource.data.empresaId) || fundadorApos(request.resource.data.empresaId));
      allow read: if master() || (logado() && admin(resource.data.empresaId));
      allow update, delete: if false;
    }

    // ---------- Todo o resto: negado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
